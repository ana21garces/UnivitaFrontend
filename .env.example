# Copiar a .env.local y ajustar.

# URL base de la API desde el navegador.
#   Local:     /api/proxy       -> lo reenvía app/api/proxy/[...path]/route.ts
#   ubuntusrv: https://ingenieria.unac.edu.co/~ana.garces/univita/api/v1
NEXT_PUBLIC_API_URL=/api/proxy

# Backend real al que apunta la ruta proxy. Solo se usa cuando
# NEXT_PUBLIC_API_URL=/api/proxy (desarrollo local).
BACKEND_URL=http://localhost:8000/api/v1

# Backend que el SERVIDOR de Next usa para servir /uploads (avatares). El
# navegador nunca ve esta URL: pide /uploads a su propio origen y Next reenvía.
#   Local:     http://localhost:8000   (o se deriva de BACKEND_URL)
#   ubuntusrv: http://127.0.0.1:8001
BACKEND_INTERNAL_URL=http://localhost:8000

# Prefijo de ruta cuando el front no se sirve en la raíz del dominio.
#   Local:     vacío
#   ubuntusrv: /~ana.garces/univita
NEXT_PUBLIC_BASE_PATH=
